rules_version = '2';

// Modelo de datos y principios: specs/platforms/backend.md
// Todo lo que no se permite aquí está denegado.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Marca de tiempo del servidor: el cliente envía serverTimestamp(), que vale request.time.
    function isServerTime(value) {
      return value is timestamp && value == request.time;
    }

    // SYN-006, SYN-007: deletedAt es null, la hora del servidor o el valor que ya tenía
    // (al editar un documento ya borrado). Nunca una fecha elegida por el cliente.
    function isSoftDeleteMark(value) {
      return value == null
        || value == request.time
        || (resource != null && value == resource.data.deletedAt);
    }

    // LIB-021: addedAt (cuándo el libro entró a la biblioteca) es opcional. Si está, es la hora del servidor
    // (al subir o volver a importar el libro) o el valor que ya tenía (al editar otro campo).
    function isAddedAt(data) {
      return !('addedAt' in data)
        || data.addedAt == request.time
        || (resource != null && 'addedAt' in resource.data && data.addedAt == resource.data.addedAt);
    }

    // ACC-004, ACC-005, ACC-002: el dueño solo lee. La creación del documento y
    // usedBytes se resuelven en K-047 y K-048.
    match /users/{uid} {
      allow read: if isOwner(uid);
    }

    // bookId = SHA-256 en hexadecimal minúscula.
    match /users/{uid}/books/{bookId} {
      function validBook() {
        let data = request.resource.data;
        return data.keys().hasAll(['title', 'authors', 'filePath', 'sizeBytes', 'createdAt', 'updatedAt', 'deletedAt'])
          && data.keys().hasOnly(['title', 'authors', 'filePath', 'sizeBytes', 'createdAt', 'updatedAt', 'deletedAt', 'addedAt'])
          && isAddedAt(data)
          && data.title is string && data.title.size() >= 1 && data.title.size() <= 500
          && data.authors is list && data.authors.size() <= 50
          && data.filePath == 'users/' + uid + '/books/' + bookId + '.epub'
          && data.sizeBytes is int && data.sizeBytes >= 0
          && isServerTime(data.updatedAt)
          && isSoftDeleteMark(data.deletedAt);
      }

      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && bookId.matches('^[a-f0-9]{64}$')
        && validBook()
        && isServerTime(request.resource.data.createdAt)
        && request.resource.data.deletedAt == null;

      // SYN-007: no hay delete. Borrar es poner deletedAt.
      allow update: if isOwner(uid)
        && validBook()
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['filePath', 'sizeBytes', 'createdAt']);
    }

    // LIB-005
    match /users/{uid}/collections/{collectionId} {
      function validCollection() {
        let data = request.resource.data;
        return data.keys().hasAll(['name', 'bookIds', 'createdAt', 'updatedAt', 'deletedAt'])
          && data.keys().hasOnly(['name', 'bookIds', 'createdAt', 'updatedAt', 'deletedAt'])
          && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
          && data.bookIds is list && data.bookIds.size() <= 5000
          && isServerTime(data.updatedAt)
          && isSoftDeleteMark(data.deletedAt);
      }

      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && validCollection()
        && isServerTime(request.resource.data.createdAt)
        && request.resource.data.deletedAt == null;

      allow update: if isOwner(uid)
        && validCollection()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt']);
    }

    // SYN-002, SYN-003, SYN-011 a SYN-013: posición de lectura, un documento por libro (ADR 0011).
    // bookId = SHA-256 del libro, y el libro tiene que existir: así la cantidad de posiciones queda acotada
    // por la de libros. Gana la lectura más reciente (readAt), no la que llega último; updatedAt es del
    // servidor y solo sirve para pedir lo que cambió desde la última vez.
    match /users/{uid}/positions/{bookId} {
      function validPosition() {
        let data = request.resource.data;
        return data.keys().hasAll(['locatorJson', 'progress', 'readAt', 'deviceId', 'deviceName', 'updatedAt'])
          && data.keys().hasOnly(['locatorJson', 'progress', 'readAt', 'deviceId', 'deviceName', 'updatedAt'])
          && data.locatorJson is string && data.locatorJson.size() >= 1 && data.locatorJson.size() <= 8192
          && (data.progress == null || (data.progress is number && data.progress >= 0 && data.progress <= 1))
          && data.readAt is int && data.readAt > 0
          // Un reloj adelantado no puede bloquear para siempre a los demás dispositivos.
          && data.readAt <= request.time.toMillis() + 3600000
          && data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 64
          && data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 64
          && isServerTime(data.updatedAt);
      }

      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && bookId.matches('^[a-f0-9]{64}$')
        && exists(/databases/$(database)/documents/users/$(uid)/books/$(bookId))
        && validPosition();

      // Un dispositivo atrasado no pisa una lectura más nueva (SYN-003, SYN-010). Igual se acepta: reenvío.
      // No hay delete: la posición de un libro borrado se ignora.
      allow update: if isOwner(uid)
        && validPosition()
        && request.resource.data.readAt >= resource.data.readAt;
    }

    // SYN-016, SYN-005, SYN-007: notas sobre un texto del libro (ANN-003). noteId = UUID de la nota.
    // Gana la edición más reciente (editedAt, reloj del dispositivo), no la que llega último; updatedAt es del
    // servidor y solo sirve para pedir lo que cambió. El libro tiene que existir (acota la cantidad).
    // Borrar es poner deletedAt. Una nota borrada revive solo con una edición posterior al borrado: gana el último
    // cambio también entre borrar y editar (SYN-005, SYN-010).
    match /users/{uid}/notes/{noteId} {
      function isDeviceTime(value) {
        // Un reloj adelantado no puede bloquear para siempre a los demás dispositivos.
        return value is int && value > 0 && value <= request.time.toMillis() + 3600000;
      }

      function validNote() {
        let data = request.resource.data;
        return data.keys().hasAll(['bookId', 'locatorJson', 'quote', 'text', 'progression', 'createdAt', 'editedAt', 'deletedAt', 'updatedAt'])
          && data.keys().hasOnly(['bookId', 'locatorJson', 'quote', 'text', 'progression', 'createdAt', 'editedAt', 'deletedAt', 'updatedAt'])
          && data.bookId is string && data.bookId.matches('^[a-f0-9]{64}$')
          && data.locatorJson is string && data.locatorJson.size() >= 1 && data.locatorJson.size() <= 8192
          && data.quote is string && data.quote.size() >= 1 && data.quote.size() <= 4000
          && data.text is string && data.text.size() <= 10000
          // Una nota viva tiene texto; una borrada puede llegar vacía.
          && (data.deletedAt != null || data.text.size() >= 1)
          && data.progression is number && data.progression >= 0 && data.progression <= 1
          && isDeviceTime(data.createdAt)
          && isDeviceTime(data.editedAt)
          && (data.deletedAt == null || isDeviceTime(data.deletedAt))
          && isServerTime(data.updatedAt);
      }

      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && noteId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
        && validNote()
        && exists(/databases/$(database)/documents/users/$(uid)/books/$(request.resource.data.bookId))
        && request.resource.data.deletedAt == null;

      // Un dispositivo atrasado no pisa una edición más nueva (SYN-005, SYN-010). Repetir el mismo editedAt se
      // acepta (reenvío), pero no sirve para revivir una nota borrada. No hay delete.
      allow update: if isOwner(uid)
        && validNote()
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['bookId', 'locatorJson', 'quote', 'progression', 'createdAt'])
        && request.resource.data.editedAt >= resource.data.editedAt
        && (resource.data.deletedAt == null
              || request.resource.data.deletedAt == resource.data.deletedAt
              || request.resource.data.editedAt > resource.data.editedAt);
    }
  }
}
