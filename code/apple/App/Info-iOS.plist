<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Entorno de la configuración de build (APL-002, ADR 0021): dev, stage, beta o prod. -->
	<key>AppEnvironment</key>
	<string>$(APP_ENVIRONMENT)</string>
	<!-- Vuelta del ingreso con Google (ADR 0015): REVERSED_CLIENT_ID de GoogleService-Info.plist, que copia
	     tools/copy-google-client.sh a Signing.local.xcconfig. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<!-- "Abrir con" un EPUB desde otra app o desde Archivos (LIB-001). Solo iOS: la Mac todavía no importa (ADR 0013).
	     La app recibe una copia y la importa a su biblioteca. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>EPUB</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.idpf.epub-container</string>
			</array>
		</dict>
	</array>
	<!-- Arranque (WEL-001, WEL-002): el amarillo de la marca (MarginColors.yellow) con los libros al centro. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
</dict>
</plist>
